# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요.
#   Windows : copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# .env는 깃에 올라가지 않습니다. 키를 커밋하지 마세요.

# P1 여행지 추첨은 키가 필요 없습니다. 아래는 다음 페이지들용입니다.

# 공공데이터포털 — 한국관광공사 TourAPI (P2)
TOUR_API_KEY=

# 카카오 개발자센터 — REST API 키 (P3)
KAKAO_REST_API_KEY=

# Hugging Face — Access Token (P2, P4)
HF_TOKEN=

# SK OpenAPI 앱 키. TMAP 대중교통 API 상품 사용 권한이 연결된 키여야 합니다.
TMAP_APP_KEY=

# 비용이 발생할 수 있는 TMAP 대중교통 API 호출 여부 (기본: false)
ENABLE_TMAP_TRANSIT=false

# true일 때만 사이드바에 TMAP 호출 on/off 개발자 옵션을 표시합니다.
DEVELOPER_MODE=false

# P2 여행 플래너의 Hugging Face Inference Providers 설정    
HF_MODEL=Qwen/Qwen3-32B
# Qwen3-32B의 JSON schema 출력 지원 provider
HF_LLM_PROVIDER=nscale
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOUR_API_ROWS_PER_TYPE=6
RAG_TOP_K=12
