# ─────────────────────────────────────────────────────────────
# 1. 베이스 이미지 — 파이썬 3.11이 깔린 가벼운 리눅스에서 시작
#    slim은 불필요한 게 빠진 버전이라 이미지가 작다
# ─────────────────────────────────────────────────────────────
FROM python:3.11-slim

# ─────────────────────────────────────────────────────────────
# 2. 컨테이너 안에서 작업할 폴더를 정한다
#    앞으로 나오는 명령어는 전부 이 폴더 기준으로 실행된다
# ─────────────────────────────────────────────────────────────
WORKDIR /app

# ─────────────────────────────────────────────────────────────
# 3. 파이썬 기본 설정
#    PYTHONDONTWRITEBYTECODE: .pyc 캐시 파일을 안 만든다
#    PYTHONUNBUFFERED: print가 바로바로 로그에 찍히게 한다
#    TZ: 시간대를 한국으로
# ─────────────────────────────────────────────────────────────
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul

# ─────────────────────────────────────────────────────────────
# 4. requirements.txt만 먼저 복사해서 설치한다
#
#    ★ 이 순서가 중요하다 ★
#    도커는 각 줄의 결과를 캐시해 둔다. 코드를 먼저 복사하면
#    코드 한 글자만 고쳐도 pip install을 처음부터 다시 한다.
#    requirements를 먼저 깔아두면, 코드만 바뀌었을 때
#    설치 단계는 캐시를 재사용해서 빌드가 몇 초로 끝난다.
# ─────────────────────────────────────────────────────────────
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ─────────────────────────────────────────────────────────────
# 5. 나머지 프로젝트 파일을 전부 복사
#    .dockerignore에 적힌 것들은 제외된다
# ─────────────────────────────────────────────────────────────
COPY . .

# ─────────────────────────────────────────────────────────────
# 6. 이 컨테이너가 8501 포트를 쓴다고 알려준다 (문서 역할)
# ─────────────────────────────────────────────────────────────
EXPOSE 8501

# ─────────────────────────────────────────────────────────────
# 7. 컨테이너가 살아있는지 주기적으로 확인
#    Streamlit이 제공하는 헬스체크 주소를 찔러본다
# ─────────────────────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"

# ─────────────────────────────────────────────────────────────
# 8. 컨테이너가 켜지면 실행할 명령
#
#    ★ --server.address=0.0.0.0 이 반드시 필요하다 ★
#    기본값(localhost)이면 컨테이너 안에서만 접속이 되고
#    내 브라우저에서는 안 열린다.
# ─────────────────────────────────────────────────────────────
CMD ["streamlit", "run", "app.py", \
     "--server.address=0.0.0.0", \
     "--server.port=8501"]
